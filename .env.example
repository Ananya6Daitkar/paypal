# PayPal Developer Dashboard > Sandbox > REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Recommended: expected Sandbox business merchant ID, checked against the live order before capture.
PAYPAL_MERCHANT_ID=

# Optional: enables semantic intent review through OpenAI Chat Completions
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

PORT=8000
